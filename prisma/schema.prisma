// Prisma schema for the Inventory & Stock Control application.
// Session 1: schema foundation only.
//
// SQLite is used for local development.
// Stock on-hand should be DERIVED from StockMovement records;
// do not add a mutable "quantity" field to Item.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum UserRole {
  MANAGER
  STAFF
}

enum StockMovementKind {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
}

// ---------------------------------------------------------
// USER
// ---------------------------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(STAFF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Locations assigned to this staff member.
  locationAssignments StaffLocationAssignment[]

  // Stock movements performed by this user.
  stockMovements StockMovement[] @relation("MovementPerformedBy")

  // Timeline events created by this user.
  timelineEvents ItemTimelineEvent[] @relation("TimelineCreatedBy")

  // Low-stock alerts dismissed by this user.
  lowStockDismissals LowStockAlertDismissal[]

  // Authentication sessions for this user.
sessions UserSession[]
}

// ---------------------------------------------------------
// USER SESSION
// ---------------------------------------------------------

model UserSession {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// LOCATION
// ---------------------------------------------------------

model Location {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  code    String  @unique
  address String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Staff members assigned to this location.
  staffAssignments StaffLocationAssignment[]

  // Normal stock movements occurring at this location.
  stockMovements StockMovement[] @relation("MovementLocation")

  // Transfer source locations.
  outgoingTransfers StockMovement[] @relation("TransferSource")

  // Transfer destination locations.
  incomingTransfers StockMovement[] @relation("TransferDestination")
}

// ---------------------------------------------------------
// CATEGORY
// ---------------------------------------------------------

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]
}

// ---------------------------------------------------------
// ITEM
// ---------------------------------------------------------

model Item {
  id          Int     @id @default(autoincrement())
  sku         String  @unique
  name        String
  description String?

  // Unit of measure, e.g. "pcs", "kg", "box".
  unitOfMeasure String

  // Stock level at or below which the item is considered low-stock.
  reorderLevel Int @default(0)

  archived Boolean @default(false)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Immutable record of stock changes for this item.
  stockMovements StockMovement[]

  // History/timeline for this item.
  timelineEvents ItemTimelineEvent[]

  // Managers' dismissals of low-stock alerts for this item.
  lowStockDismissals LowStockAlertDismissal[]
}

// ---------------------------------------------------------
// STAFF ↔ LOCATION ASSIGNMENT
// ---------------------------------------------------------

model StaffLocationAssignment {
  id Int @id @default(autoincrement())

  userId     Int
  locationId Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // A staff member should not be assigned to the same
  // location more than once.
  @@unique([userId, locationId])
}

// ---------------------------------------------------------
// STOCK MOVEMENT
// ---------------------------------------------------------

model StockMovement {
  id Int @id @default(autoincrement())

  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  kind StockMovementKind

  // Quantity involved in the movement.
//
// RECEIPT, ISSUE, and TRANSFER require a positive quantity.
// ADJUSTMENT may use a positive or negative quantity, but
// zero is not allowed. Negative adjustments reduce stock.
quantity Int

  // Used for RECEIPT, ISSUE, and ADJUSTMENT.
  locationId Int?
  location   Location? @relation("MovementLocation", fields: [locationId], references: [id])

  // Used when kind = TRANSFER.
  sourceLocationId Int?
  sourceLocation   Location? @relation("TransferSource", fields: [sourceLocationId], references: [id])

  destinationLocationId Int?
  destinationLocation   Location? @relation("TransferDestination", fields: [destinationLocationId], references: [id])

  // Required later for adjustments and useful for auditability.
  reason String?

  // Optional human-readable notes.
  notes String?

  performedById Int
  performedBy   User @relation("MovementPerformedBy", fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  // No updatedAt field intentionally:
  // stock movements are append-only and must never be edited.
}

// ---------------------------------------------------------
// ITEM TIMELINE EVENT
// ---------------------------------------------------------

model ItemTimelineEvent {
  id Int @id @default(autoincrement())

  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  createdById Int
  createdBy   User @relation("TimelineCreatedBy", fields: [createdById], references: [id])

  // Examples:
  // ITEM_CREATED
  // ITEM_UPDATED
  // ITEM_ARCHIVED
  // ITEM_RESTORED
  eventType String

  // Optional description of what happened.
  description String?

  // Useful for recording field-level changes.
  fieldName String?
  oldValue  String?
  newValue  String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// LOW-STOCK ALERT DISMISSAL
// ---------------------------------------------------------

model LowStockAlertDismissal {
  id Int @id @default(autoincrement())

  itemId Int
  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  dismissedById Int
  dismissedBy   User @relation(fields: [dismissedById], references: [id])

  dismissedAt DateTime @default(now())

  // One active dismissal record per item/user combination.
  @@unique([itemId, dismissedById])
}
